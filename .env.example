# Proof of Remittance environment variables. Nothing here is required for
# `npm run demo`, which generates its own throwaway notary key and wires the
# services together. Copy to .env only if you run the pieces by hand.
# Never put a key that controls real funds in any of these.

# --- notary (prover-rs/target/release/notary)
# 32-byte hex secp256k1 key the notary signs attestations with. Use a
# dedicated key: any EIP-191 signature it makes is a candidate attestation.
NOTARY_KEY=

# --- verifier service (npm run verifier)
# Address of the only notary key the service accepts (0x + 40 hex).
NOTARY_ADDRESS=
# Port on 127.0.0.1 (default 8787).
VERIFIER_PORT=8787

# --- mock bank (npm run bank)
# HTTPS statement API port (default 8443).
BANK_PORT=8443
# Plain-HTTP credit simulator port (default 8444).
BANK_SIM_PORT=8444
# Set to 1 to serve the impostor certificate (chained to a CA the notary does not trust).
BANK_EVIL=

# --- demo port overrides (npm run demo), all on 127.0.0.1
POR_ANVIL_PORT=18545
POR_BANK_PORT=18443
POR_SIM_PORT=18444
POR_EVIL_PORT=18445
POR_EVIL_SIM_PORT=18446
POR_NOTARY_PORT=17047
POR_VERIFIER_PORT=18787
# Set to any value to disable ANSI colors in demo output.
NO_COLOR=
